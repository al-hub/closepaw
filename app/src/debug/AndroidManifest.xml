<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Debug-only: allow ADB to launch the VD viewer for testing -->
    <application>
        <activity
            android:name="ai.closepaw.qa.LocalCaptureQaActivity"
            android:enabled="${captureQaEnabled}"
            android:exported="false" />
        <!-- Candidate-only started FGS. No exported start, no reboot, no auto-resume
             after process death, and no projection/Accessibility permission bypass. -->
        <service
            android:name="ai.closepaw.qa.DebugQaRunnerService"
            android:enabled="${captureQaEnabled}"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Locally armed bounded on-device physical keyboard QA, continuing during Chrome screen transitions with persistent results and a visible Stop action" />
        </service>
        <provider
            android:name="ai.closepaw.qa.CaptureQaFileProvider"
            android:authorities="${applicationId}.captureqa"
            android:enabled="${captureQaEnabled}"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/capture_qa_paths" />
        </provider>
        <activity
            android:name=".ui.viewer.VirtualDisplayViewerActivity"
            android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
